"""Diarize an audio file using speechbrain speaker embeddings.

Takes a whisper SRT file + audio, clusters speakers, outputs fountain format.

Usage: bin/diarize <audio.wav> <input.srt> <output.txt>
"""

import re
import sys
import numpy as np
from pathlib import Path

import torch
import torchaudio
import librosa
from speechbrain.inference.speaker import EncoderClassifier
from sklearn.cluster import AgglomerativeClustering


def parse_srt(path):
    """Parse SRT file into list of (start_sec, end_sec, text) tuples."""
    segments = []
    with open(path, "r", encoding="utf-8") as f:
        content = f.read()

    blocks = re.split(r"\n\n+", content.strip())
    for block in blocks:
        lines = block.strip().split("\n")
        if len(lines) < 3:
            continue
        # Line 2: timestamp "00:01:23,456 --> 00:01:25,789"
        m = re.match(
            r"(\d+):(\d+):(\d+)[,.](\d+)\s*-->\s*(\d+):(\d+):(\d+)[,.](\d+)",
            lines[1],
        )
        if not m:
            continue
        g = [int(x) for x in m.groups()]
        start = g[0] * 3600 + g[1] * 60 + g[2] + g[3] / 1000
        end = g[4] * 3600 + g[5] * 60 + g[6] + g[7] / 1000
        text = " ".join(lines[2:]).strip()
        if text:
            segments.append((start, end, text))

    return segments


def extract_embeddings(audio_path, segments, classifier, batch_size=500):
    """Extract speaker embedding for each segment in batches to limit memory."""
    import gc
    import soundfile as sf

    info = sf.info(audio_path)
    sr = info.samplerate
    total_frames = info.frames

    if sr != 16000:
        # fallback: load and resample entire file
        data, sr = librosa.load(audio_path, sr=16000, mono=True)
        signal_np = data
        sr = 16000
    else:
        data, _ = sf.read(audio_path, dtype="float32", always_2d=True)
        # mono
        signal_np = data.mean(axis=1) if data.shape[1] > 1 else data[:, 0]

    emb_dim = 192  # ECAPA-TDNN output dimension
    n = len(segments)
    # pre-allocate result array on disk via memmap to avoid RAM spike
    emb_path = Path(audio_path).parent / ".embeddings.npy"
    all_emb = np.memmap(emb_path, dtype="float32", mode="w+", shape=(n, emb_dim))
    valid_mask = np.zeros(n, dtype=bool)

    for batch_start in range(0, n, batch_size):
        batch_end = min(batch_start + batch_size, n)
        print(f"  embeddings {batch_start+1}-{batch_end}/{n}...", file=sys.stderr)

        for i in range(batch_start, batch_end):
            start, end, _text = segments[i]
            s = int(start * sr)
            e = int(end * sr)
            if e - s < int(sr * 0.3):
                continue
            chunk = torch.from_numpy(signal_np[s:e]).unsqueeze(0)
            emb = classifier.encode_batch(chunk)
            all_emb[i] = emb.squeeze().cpu().numpy()
            valid_mask[i] = True
            del chunk, emb

        all_emb.flush()
        gc.collect()
        torch.cuda.empty_cache() if torch.cuda.is_available() else None

    # Convert to list format expected by cluster_speakers
    embeddings = []
    for i in range(n):
        if valid_mask[i]:
            embeddings.append(np.array(all_emb[i]))
        else:
            embeddings.append(None)

    del all_emb, signal_np
    gc.collect()
    # clean up temp file
    try:
        emb_path.unlink()
    except OSError:
        pass

    return embeddings


def cluster_speakers(embeddings, n_clusters=None):
    """Cluster embeddings into speakers. Auto-detect count if not specified."""
    valid = [(i, e) for i, e in enumerate(embeddings) if e is not None]
    if not valid:
        return [0] * len(embeddings)

    indices, embs = zip(*valid)
    X = np.stack(embs)

    if n_clusters is None:
        # Try 2-8 speakers, pick by silhouette score
        from sklearn.metrics import silhouette_score

        best_score = -1
        best_n = 2
        max_n = min(8, len(X) - 1)
        if max_n < 2:
            labels_all = [0] * len(embeddings)
            return labels_all

        for n in range(2, max_n + 1):
            clustering = AgglomerativeClustering(
                n_clusters=n, metric="cosine", linkage="average"
            )
            labels = clustering.fit_predict(X)
            if len(set(labels)) < 2:
                continue
            score = silhouette_score(X, labels, metric="cosine")
            if score > best_score:
                best_score = score
                best_n = n

        n_clusters = best_n

    clustering = AgglomerativeClustering(
        n_clusters=n_clusters, metric="cosine", linkage="average"
    )
    labels = clustering.fit_predict(X)

    # Map back to full list
    labels_all = [0] * len(embeddings)
    for idx, label in zip(indices, labels):
        labels_all[idx] = int(label)

    return labels_all


def format_fountain(segments, labels):
    """Format as fountain: timestamps + speaker labels + dialogue."""
    lines = []
    prev_speaker = None

    for (start, _end, text), label in zip(segments, labels):
        speaker = f"SPEAKER_{label:02d}"

        # Add timestamp at speaker changes or every few minutes
        if prev_speaker != speaker:
            h = int(start) // 3600
            m = int(start) % 3600 // 60
            s = int(start) % 60
            lines.append(f"[[{h:02d}:{m:02d}:{s:02d}]]")
            lines.append(speaker)
            lines.append(text)
            lines.append("")
        else:
            lines.append(text)
            lines.append("")

        prev_speaker = speaker

    return "\n".join(lines)


def main():
    if len(sys.argv) < 4:
        print("Usage: diarize <audio.wav> <input.srt> <output.txt>", file=sys.stderr)
        sys.exit(1)

    audio_path = sys.argv[1]
    srt_path = sys.argv[2]
    output_path = sys.argv[3]

    print("  loading speaker model...", file=sys.stderr)
    classifier = EncoderClassifier.from_hparams(
        source="speechbrain/spkrec-ecapa-voxceleb",
        savedir=Path.home() / ".cache" / "speechbrain" / "spkrec-ecapa-voxceleb",
        run_opts={"device": "cpu"},
    )

    print("  parsing SRT...", file=sys.stderr)
    segments = parse_srt(srt_path)
    print(f"  {len(segments)} segments", file=sys.stderr)

    print("  extracting speaker embeddings...", file=sys.stderr)
    embeddings = extract_embeddings(audio_path, segments, classifier)

    print("  clustering speakers...", file=sys.stderr)
    labels = cluster_speakers(embeddings)
    n_speakers = len(set(labels))
    print(f"  {n_speakers} speakers detected", file=sys.stderr)

    result = format_fountain(segments, labels)

    with open(output_path, "w", encoding="utf-8") as f:
        f.write(result)

    print(f"  -> {output_path}", file=sys.stderr)


if __name__ == "__main__":
    main()
